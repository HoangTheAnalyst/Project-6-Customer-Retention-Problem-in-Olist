	column 'Is Weekend'
		lineageTag: 702b8369-866d-4746-9aec-3596858b0482
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Weekend]

		annotation SummarizationSetBy = Automatic

	partition dim_date = calculated
		mode: import
		source =
				
				VAR StartDate = DATE(2016, 1, 1)
				VAR EndDate = DATE(2018, 12, 31)
				RETURN
				ADDCOLUMNS (
				    CALENDAR(StartDate, EndDate),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Month Short", FORMAT([Date], "MMM"),
				    "Quarter", "Q" & FORMAT([Date], "Q"),
				    "Year Quarter", FORMAT([Date], "YYYY") & " Q" & FORMAT([Date], "Q"),
				    "Year Month", FORMAT([Date], "YYYY-MM"),
				    "Day of Week Number", WEEKDAY([Date], 2), -- 1 là Thứ 2
				    "Day of Week", FORMAT([Date], "DDDD"),
				    "Is Weekend", IF(WEEKDAY([Date], 2) > 5, "Weekend", "Weekday")
				)

	annotation PBI_Id = 66a3fd1b239c4f2c88ce9d2a12c5a21d

